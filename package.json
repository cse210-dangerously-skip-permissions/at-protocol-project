{
  "name": "at-protocol-project",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.5.0"
  },
  "workspaces": [
    "lexicons",
    "infra",
    "packages/*",
    "services/*",
    "tools/*"
  ],
  "scripts": {
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "stack:up": "node infra/scripts/stack.mjs up",
    "stack:check": "node infra/scripts/stack.mjs check",
    "stack:seed": "node infra/scripts/stack.mjs seed",
    "stack:down": "node infra/scripts/stack.mjs down",
    "stack:reset": "node infra/scripts/stack.mjs reset",
    "stack:logs": "node infra/scripts/stack.mjs logs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage && node scripts/check-coverage.mjs"
  },
  "lint-staged": {
    "*": "prettier --write --ignore-unknown"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^22.20.5",
    "@vitest/coverage-v8": "^4.1.12",
    "eslint": "^9.39.5",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "prettier": "^3.9.10",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.2",
    "vitest": "^4.1.12"
  },
  "overrides": {
    "vite": "^6.4.6"
  }
}
